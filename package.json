{
  "name": "lcg-app",
  "version": "1.0.0",
  "description": "Le Cube Graphique - Web App Fullstack Mobile-First",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "build": "npm --prefix client run build",
    "start": "node server.js",
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon server.js",
    "client:dev": "npm --prefix client run dev",
    "lint": "npm --prefix client run lint",
    "test": "jest --runInBand server/tests",
    "validate": "npm test && npm run lint && npm --prefix client run build -- --outDir ../tmp/poc-audit/client-build",
    "test:swarm": "node scripts/agent-swarm/run-four-player-simulation.js --spawn-server --scenario scripts/agent-swarm/scenarios/default-four-player.json",
    "worklog": "node docs/worklog-site/server.js",
    "test:worklog": "node --test docs/worklog-site/server.test.js",
    "studio:dev": "cd question-studio && npm run dev",
    "studio:build": "cd question-studio && npm run build"
  },
  "keywords": [
    "game",
    "real-time",
    "socket.io",
    "react"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "socket.io-client": "^4.8.3"
  },
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  }
}
